# Copy this file to .env (or set these as real environment variables /
# HostPinnacle "Setup Python App" env vars) and fill in real values.
# .env is already listed in .gitignore — never commit the filled-in version.

# Required only when DJANGO_DEBUG=False (i.e. on the live server).
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Set to True only for local development. Leave unset (or False) in production.
DJANGO_DEBUG=False

# Zoho SMTP password for info@obusubiriassociates.co.ke.
# Only needed in production — local dev prints emails to the console instead.
EMAIL_HOST_PASSWORD=
